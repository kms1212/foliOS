CompileFlags:
  Add:
    - -std=c11
    - -xc
    - -D__STDC_HOSTED__=0
    - -Wall
    - -Wextra
    - -nostdinc
    - -Icommon/include
    - -D_Atomic(X)=X

---
If:
  PathMatch: vellum/.*
CompileFlags:
  CompilationDatabase: build/vellum

---
If:
  PathMatch: strata/.*
CompileFlags:
  CompilationDatabase: build/strata

---
If:
  PathMatch: strata/tests/.*
CompileFlags:
  CompilationDatabase: build/strata/tests
