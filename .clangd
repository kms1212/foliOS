CompileFlags:
  Add:
    - -std=c11
    - -xc
    - -D__STDC_HOSTED__=0
    - -Wall
    - -Wextra
    - -Icommon/include

---
If:
  PathMatch: vellum/.*
CompileFlags:
  CompilationDatabase: build/vellum
  Add:
    - --target=i686-elf
    - -isystem /opt/homebrew/Cellar/i686-elf-gcc/15.2.0/lib/gcc/i686-elf/15.2.0/include

---
If:
  PathMatch: strata/.*
CompileFlags:
  CompilationDatabase: build/strata
  Add:
    - --target=x86_64-elf
    - -isystem /opt/homebrew/Cellar/x86_64-elf-gcc/15.2.0/lib/gcc/x86_64-elf/15.2.0/include

---
If:
  PathMatch: strata/tests/.*
CompileFlags:
  CompilationDatabase: build/strata/tests
  Remove:
    - --target=x86_64-elf
    - -isystem /opt/homebrew/Cellar/x86_64-elf-gcc/15.2.0/lib/gcc/x86_64-elf/15.2.0/include
