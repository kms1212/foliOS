PROJECT_NAME           = "@FOLIOS_DOXYGEN_PROJECT_NAME@"
PROJECT_BRIEF          = "@FOLIOS_DOXYGEN_PROJECT_BRIEF@"
OUTPUT_DIRECTORY       = "@FOLIOS_DOXYGEN_OUTPUT_DIRECTORY@"

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@CMAKE_SOURCE_DIR@"

@FOLIOS_DOXYGEN_INPUT@

@FOLIOS_DOXYGEN_INCLUDE_PATH@

RECURSIVE              = YES
FILE_PATTERNS          = *.h *.md
EXCLUDE_PATTERNS       = */build/* */folisdk/* */.git/*

USE_MDFILE_AS_MAINPAGE = "@FOLIOS_DOXYGEN_MAINPAGE@"
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 5

EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = NO

OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
@FOLIOS_DOXYGEN_PREDEFINED@

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
@FOLIOS_DOXYGEN_HTML_EXTRA_STYLESHEET@

GENERATE_XML           = YES
XML_OUTPUT             = xml

GENERATE_LATEX         = YES
HAVE_DOT               = NO
