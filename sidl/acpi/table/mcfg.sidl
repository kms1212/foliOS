@uuid("3E30B1DB-32E4-4CD5-999C-02ADFE52C417", "folios/interface/acpi/table/mcfg")
@prefix("StIfAcpiTblMcfg_")
interface AcpiTableMcfg {
    abirevision 0 {
        struct Entry {
            u64 base_address;
            u16 pci_segment_group;
            u8 start_bus;
            u8 end_bus;
        };

        function GetEntryCount(out u32 count);
        function GetEntry(in u32 index, out Entry entry);
    }
}